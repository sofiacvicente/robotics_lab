<mujoco model="golf_player_upper_body">
  <!--
    Primeira versão do jogador: tronco e dois braços.
    Unidades SI: metros, quilogramas, segundos e radianos.

    O comprimento do taco foi ajustado para cerca de 0.70 m nesta pose, para
    ficar proporcional ao corpo da referência. A bola mantém o diâmetro real.
  -->
  <option gravity="0 0 -9.81" timestep="0.001" integrator="RK4"/>

  <visual>
    <global azimuth="130" elevation="-15"/>
  </visual>

  <worldbody>
    <!-- Campo e bola. As pernas serão adicionadas numa próxima versão. -->
    <geom name="ground" type="plane" size="5 5 0.1"
          friction="0.25 0.005 0.0001" rgba="0.2 0.5 0.2 1"/>

    <!-- Tronco com rotação inicial de 45 graus em torno do eixo vertical z. -->
    <body name="torso" pos="0 0 1.10">
      <joint name="torso_rotation" type="hinge" axis="0 0 1"
             damping="0.08" range="-1.57 1.57" limited="true"/>
      <!-- O tronco tem massa aproximada de 25 kg e é visualmente uma cápsula. -->
      <geom name="torso_geom" type="capsule" fromto="0 0 -0.25 0 0 0.25"
            size="0.18" mass="25" rgba="0.25 0.35 0.5 1"/>

      <!-- Braço direito: ombro, braço superior, antebraço e mão/taco. -->
      <body name="right_upper_arm" pos="0 -0.20 0.20">
        <!-- Rotação no plano x-z, com eixo y. -->
        <joint name="right_shoulder" type="hinge" axis="0 1 0"
               damping="0.05" range="-1.8 1.8" limited="true"/>
          <geom name="right_upper_arm_geom" type="capsule"
            fromto="0 0 0 0 0.20 -0.30" size="0.055" mass="2.0"
              rgba="0.85 0.65 0.45 1"/>

        <body name="right_forearm" pos="0 0 -0.30">
          <joint name="right_elbow" type="hinge" axis="0 1 0"
                 damping="0.03" range="-2.6 0.1" limited="true"/>
          <geom name="right_forearm_geom" type="capsule"
                fromto="0 0 0 0 0 -0.26" size="0.045" mass="1.2"
                rgba="0.85 0.65 0.45 1"/>

          <body name="right_hand" pos="0 0 -0.26">
            <geom name="right_hand_geom" type="sphere" size="0.065"
                  mass="0.45" rgba="0.85 0.65 0.45 1"/>
            <!--
              O taco está preso à mão nesta etapa; a junta do pulso virá depois.
              A haste tem 0.70 m, desde a mão até perto do chão.
            -->
            <geom name="club_shaft" type="capsule"
                  fromto="0 0 0 0 0 -0.70" size="0.006" mass="0.30"
                  rgba="0.2 0.3 0.8 1"/>
            <!--
              Cabeça curta e fina, transversal à haste e deslocada para o lado.
              Dimensões aproximadas: 80 x 24 x 12 mm.
              A haste entra na extremidade da cabeça, em vez de ficar centrada
              como num martelo. A massa mantém-se em 0.100 kg.
            -->
            <geom name="club_head" type="box" pos="0.04 0 -0.70"
              size="0.04 0.012 0.006" mass="0.10"
              friction="0.05 0.005 0.0001" rgba="0.15 0.15 0.18 1"/>
          </body>
        </body>
      </body>

      <!-- Braço esquerdo, modelado separadamente para representar as duas mãos. -->
      <body name="left_upper_arm" pos="0 0.20 0.20">
        <joint name="left_shoulder" type="hinge" axis="0 1 0"
               damping="0.05" range="-1.8 1.8" limited="true"/>
          <geom name="left_upper_arm_geom" type="capsule"
            fromto="0 0 0 0 -0.20 -0.30" size="0.055" mass="2.0"
              rgba="0.85 0.65 0.45 1"/>

        <body name="left_forearm" pos="0 0 -0.30">
          <joint name="left_elbow" type="hinge" axis="0 1 0"
                 damping="0.03" range="-2.6 0.1" limited="true"/>
          <geom name="left_forearm_geom" type="capsule"
                fromto="0 0 0 0 0 -0.26" size="0.045" mass="1.2"
                rgba="0.85 0.65 0.45 1"/>
          <geom name="left_hand_geom" type="sphere" pos="0 0 -0.26"
                size="0.065" mass="0.45" rgba="0.85 0.65 0.45 1"/>
        </body>
      </body>
    </body>

    <!-- Bola de golfe: 45 g e 42 mm de diâmetro. -->
    <body name="golf_ball" pos="0.04 0 0.021">
      <freejoint/>
      <geom name="ball" type="sphere" size="0.021" mass="0.045"
            friction="0.25 0.005 0.0001" rgba="1 1 1 1"/>
    </body>
  </worldbody>
</mujoco>
